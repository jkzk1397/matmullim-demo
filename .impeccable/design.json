  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "행동 묶음에서 하나인 주 행동. 오른쪽 끝.",
      "html": "<button class=\"ds-btn-primary\">고치기 · 고친 문서 올리기</button>",
      "css": ".ds-btn-primary{font-family:'Pretendard Variable',Pretendard,system-ui,sans-serif;letter-spacing:-0.01em;font-variant-numeric:tabular-nums;display:inline-flex;align-items:center;justify-content:center;gap:8px;height:40px;padding:0 16px;border:none;border-radius:8px;font-size:14px;line-height:22px;font-weight:700;cursor:pointer;transition:background-color 150ms,color 150ms;background:#0d2b57;color:#fff;}.ds-btn-primary:hover{background:#163d75;}.ds-btn-primary:focus-visible{outline:2px solid #0b5cad;outline-offset:2px;}.ds-btn-primary:disabled{opacity:.4;cursor:not-allowed;}"
    },
